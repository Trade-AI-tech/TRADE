# ===========================================
# Trading AI — Environment Variables
# ===========================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#   cp .env.example .env.local
#
# รายการข้างล่างคือตัวแปรที่โค้ด "อ่านจริง" ทั้งหมด ไม่มีตัวไหนเกินมา
# ตรวจซ้ำได้ด้วย: grep -rho "process\.env\.[A-Z_]*" src/ | sort -u

# -------------------------------------------
# Supabase — จำเป็น
# หาได้ที่ https://supabase.com/dashboard/project/_/settings/api
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service-role ข้าม RLS ได้ ใช้เฉพาะฝั่ง server (cron + เขียน market_prices)
# ⚠ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด ไม่งั้นคีย์จะหลุดไปอยู่ใน bundle ฝั่ง browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# โหมด Demo
# true  = ใช้ข้อมูลตัวอย่างใน src/lib/demo-data.ts ไม่ต่อฐานข้อมูล ไม่ต้องล็อกอิน
# false = ใช้งานจริง ต้องมีค่า Supabase ข้างบนครบ
# -------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false

# -------------------------------------------
# Cron secret — ป้องกัน endpoint ฝั่งงานเบื้องหลังไม่ให้ใครก็ยิงได้
#
# ⚠ ตัวนี้ใช้กับ "ฝั่ง Vercel / Next.js เท่านั้น" — คือ route ใต้ src/app/api/cron/
#   ตัวเฝ้าราคาที่ทำงานจริงตอนนี้ย้ายไปอยู่บน Supabase Edge Function แล้ว
#   และฝั่งนั้นใช้ secret คนละตัวชื่อ MONITOR_SECRET (ดูหมายเหตุท้ายบล็อกนี้)
#
# ใช้ร่วมกัน 2 route และทั้งสองไม่เหมือนกัน:
#
#   /api/cron/monitor-positions  (เฝ้าราคา SL/TP ฉบับที่รันบน Vercel)
#     ⚠ บังคับต้องมีค่า — เป็น fail-closed คือ "ไม่มี secret = ปฏิเสธทุกคำขอ"
#       ถ้าเว้นว่างไว้ route นี้จะไม่ทำงานเลย (ไม่ใช่ "เปิดโล่ง" แต่คือ "ตายสนิท")
#       ถ้ายิงจาก GitHub Actions ค่าตรงนี้ต้องตรงกับ secret CRON_SECRET ใน GitHub ไม่งั้นได้ 401
#
#   /api/cron/scan-markets       (สแกนตลาดรายวัน — ยิงจาก Vercel Cron)
#     ถ้าเว้นว่าง endpoint นี้จะเปิดโล่ง (โค้ดข้ามการตรวจเมื่อไม่มีค่า)
#
# Vercel สร้างให้อัตโนมัติเมื่อ deploy จริง ตั้งเองเฉพาะตอน dev
# ทดสอบ: curl -H "Authorization: Bearer <ค่าที่ตั้ง>" localhost:3000/api/cron/monitor-positions
#
# ⚠ สถานะจริงตอนนี้: บัญชี Vercel ถูกระงับเพราะใช้เกินโควตาแผน Hobby
#   ทุกโดเมนตอบ HTTP 402 อยู่ ทั้งสอง route ข้างบนจึงยิงไม่ถึงบน production
#   ค่านี้ยังต้องกรอกไว้สำหรับรันในเครื่อง (npm run dev) และเผื่อวันที่ Vercel กลับมา
# -------------------------------------------
CRON_SECRET=your-cron-secret

# -------------------------------------------
# MONITOR_SECRET — ไม่ต้องใส่ในไฟล์นี้ (เขียนไว้เพื่อกันสับสน)
#
# Edge Function `monitor-positions` บน Supabase ใช้ secret ชื่อ MONITOR_SECRET
# ซึ่ง "คนละที่และคนละตัว" กับ CRON_SECRET ข้างบน:
#
#   CRON_SECRET     → ตั้งที่ Vercel → Project → Settings → Environment Variables
#                     (และ .env.local ของเครื่องตัวเอง) · โค้ด Next.js เป็นคนอ่าน
#                     ส่งมาทาง header  Authorization: Bearer <ค่า>
#   MONITOR_SECRET  → ตั้งที่ Supabase Dashboard → Edge Functions → Secrets
#                     · โค้ด Deno ใน Edge Function เป็นคนอ่าน ไม่เกี่ยวกับ .env.local เลย
#                     ส่งมาทาง header  x-monitor-secret: <ค่า>
#
# ใส่ MONITOR_SECRET ลงใน .env.local ไม่มีผลอะไรทั้งสิ้น เพราะไม่มีโค้ดฝั่ง Next.js อ่านมัน
# ตัวจับเวลา (pg_cron) อ่านค่าจาก Vault ในฐานข้อมูล ไม่ได้อ่านจากไฟล์นี้ —
# ค่าที่ใส่ใน Vault ตอนรัน migration 004 ต้องตรงกับที่ตั้งใน Edge Functions → Secrets
# ไม่ตรงกัน = ปลายทางตอบ 401 ทุกรอบ (เห็นได้ที่ตาราง net._http_response)
# ขั้นตอนตั้งค่าเต็มอยู่ในหัวข้อ "ติดตั้งตัวเฝ้าราคาบน Supabase" ของ README.md
# -------------------------------------------

# ===========================================
# ยังไม่ได้ใช้ — อย่าเพิ่งใส่
# ===========================================
# ราคาและแท่งเทียนทั้งหมดดึงจาก Yahoo Finance ซึ่งไม่ต้องใช้ API key
# ระบบจึงทำงานครบวงจรได้ด้วย 5 ตัวแปรข้างบนเท่านั้น
#
# ตัวแปรข้างล่างยังไม่มีโค้ดบรรทัดไหนอ่าน ใส่ไปก็ไม่เกิดอะไรขึ้น
# ปลดคอมเมนต์เมื่อเขียนส่วนที่เรียกใช้เสร็จแล้วเท่านั้น
#
# ANTHROPIC_API_KEY=sk-ant-...     # สำหรับให้ Claude สรุปเหตุผลสัญญาณ
# NEWS_API_KEY=...                 # สำหรับป้อน sentiment ข่าวเข้า generateSignal
