    "check:ui-claims:self": "node scripts/check-ui-claims.mjs --self-test",
    "check:parity": "node scripts/check-monitor-parity.mjs",
    "check:parity:scan": "node scripts/check-scan-parity.mjs",
    "check:parity:resolver": "node scripts/check-resolver-parity.mjs",
    "test:resolver": "node scripts/test-resolve-signals.mjs",
    "test:scorecard": "node scripts/test-scorecard-stats.mjs",
    "test:costs": "node scripts/test-costs.mjs",
    "test:indicators": "node scripts/test-indicators.mjs",
    "test:health": "node scripts/test-scan-health.mjs",
    "test:sanitizer": "node scripts/test-candle-sanitizer.mjs",
    "test:evidence": "node scripts/test-signal-evidence.mjs",
    "backtest": "node scripts/run-backtest.mjs",
    "scan:universe": "node scripts/scan-universe.mjs",
    "scan:universe:dry": "node scripts/scan-universe.mjs --dry-run",
    "news:fetch": "node scripts/fetch-news.mjs",
    "news:fetch:dry": "node scripts/fetch-news.mjs --dry-run",
    "lab:parity": "node scripts/research/check-lab-parity.mjs",
    "lab:config": "node scripts/research/engine-lab.mjs",
    "check:determinism": "node scripts/research/check-determinism.mjs",
    "check:determinism:self": "node scripts/research/check-determinism.mjs --self-test",
